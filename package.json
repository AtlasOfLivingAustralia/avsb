{
  "name": "avsb",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:production": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:testing": "tsc -b && vite build --mode testing",
    "build:development": "tsc -b && vite build --mode development",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint ./src",
    "lint:fix": "biome check --write ./src",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@mantine/carousel": "^9.4.0",
    "@mantine/charts": "^9.4.0",
    "@mantine/core": "^9.4.0",
    "@mantine/dates": "^9.4.0",
    "@mantine/form": "^9.4.0",
    "@mantine/hooks": "^9.4.0",
    "@mantine/nprogress": "^9.4.0",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@tabler/icons-react": "^3.44.0",
    "dayjs": "^1.11.21",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "lodash": "^4.18.1",
    "mapbox-gl": "^3.25.0",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-router": "^8.0.1",
    "react-window": "^2.2.7",
    "recharts": "^3.9.0",
    "wellknown": "^0.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@graphql-codegen/cli": "^7.4.2",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.24",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/wellknown": "^0.5.8",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}