    "@tabler/icons-react": "^3.42.0",
    "dayjs": "^1.11.20",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "lodash": "^4.18.1",
